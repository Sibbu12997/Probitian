# ProBitian environment template
# Copy to .env for local development. Never commit .env or real secrets.
# Public values use VITE_ and may be embedded in the browser bundle.
# Non-VITE credentials must remain server-side.

APP_URL="https://probitian.ai.studio"
VITE_SITE_URL="https://probitian.ai.studio"

# Public social destinations; keep aligned with live settings
VITE_YOUTUBE_URL="https://youtube.com/@probitian"
VITE_INSTAGRAM_URL="https://instagram.com/probitian"
VITE_FACEBOOK_URL="https://facebook.com/probitian"
VITE_GITHUB_URL="https://github.com/probitian"
VITE_X_URL="https://x.com/Probitian"
VITE_LINKEDIN_URL="https://www.linkedin.com/company/probitian/"
VITE_CONTACT_EMAIL="probitianofficial@gmail.com"

# Supabase; anon key is public but governed by RLS
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Privileged backend credential; never use VITE_ prefix
SUPABASE_SECRET_KEY=""

# Admin authentication/session (server-side)
ADMIN_PASSKEY=""
ADMIN_EMAILS=""
SESSION_SECRET=""
CORS_ALLOWED_ORIGINS=""

# Required in production for unsubscribe signing; minimum 32 random bytes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=""

# Optional Gemini AI integration (server-side)
GEMINI_API_KEY=""

# Optional Power BI demo report URL
POWERBI_DEMO_URL=""

# Optional Google Analytics 4
VITE_GA4_MEASUREMENT_ID=""
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""

# Optional Gmail SMTP (server-side)
GMAIL_USER="probitianofficial@gmail.com"
GMAIL_APP_PASSWORD=""
