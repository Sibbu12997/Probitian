# ============================================================
# ProBitian Environment Variables Template
# Project Owner: Shivam Singh
# Official Website: https://probitian.ai.studio/
# Official Contact Email: probitianofficial@gmail.com
# ============================================================

# GEMINI AI API (Server Side Only)
# Required for AI-powered data analytics assistant and automated summaries
GEMINI_API_KEY=""

# HOSTED APPLICATION URL
# The primary URL where this applet is deployed and served
APP_URL="https://probitian.ai.studio/"

# CLIENT-SIDE BRAND & SOCIAL MEDIA CONFIGURATION
# Publicly accessible client configuration
VITE_SITE_URL="https://probitian.ai.studio/"
VITE_YOUTUBE_URL="https://youtube.com/@probitian"
VITE_INSTAGRAM_URL="https://instagram.com/probitian"
VITE_FACEBOOK_URL="https://facebook.com/probitian"
VITE_GITHUB_URL="https://github.com/probitian"
VITE_CONTACT_EMAIL="probitianofficial@gmail.com"

# SUPABASE POSTGRESQL & STORAGE CONFIGURATION
# VITE_ variables are public for client-side queries protected by RLS
# SUPABASE_SECRET_KEY is strictly server-side for authenticated CMS mutations
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SECRET_KEY=""

# ADMINISTRATIVE PORTAL AUTHENTICATION (Server Side Only)
# Passkey for unlocking the admin management portal at /#/admin
ADMIN_PASSKEY=""

# GOOGLE ANALYTICS 4 (GA4) INTEGRATION
# VITE_GA4_MEASUREMENT_ID: Public client-side tracking ID (e.g., G-XXXXXXXXXX)
# GA4_PROPERTY_ID, GA4_CLIENT_EMAIL, GA4_PRIVATE_KEY: Server-side reporting via Google Analytics Data API
VITE_GA4_MEASUREMENT_ID=""
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""

# GMAIL SMTP EMAIL INFRASTRUCTURE (Server Side Only)
# Used by Express server via Nodemailer for newsletter welcome emails, contact alerts & admin replies
GMAIL_USER="probitianofficial@gmail.com"
GMAIL_APP_PASSWORD=""
